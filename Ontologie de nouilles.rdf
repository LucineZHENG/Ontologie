    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Farine_gluten -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Farine_gluten">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Farine"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Aliments_sans_gluten"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Farine_sans_gluten -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Farine_sans_gluten">
