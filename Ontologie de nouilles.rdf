    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Aliments_sans_gluten -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Aliments_sans_gluten">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#est_sans_gluten"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Restrictions_de_diète"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Aliments_végétariens -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Aliments_végétariens">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#est_vegetarien"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Restrictions_de_diète"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Fruits_de_mer"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Viande"/>
