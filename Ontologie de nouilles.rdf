    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Nouilles_riche_en_calories -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Nouilles_riche_en_calories">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Nouilles"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/contient_des_calories"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">501</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Nouilles"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Nouilles_saveur_lourd -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#Nouilles_saveur_lourd">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Nouilles"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#a_saveur_de"/>
                        <owl:hasValue>pimenté</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7#a_saveur_de"/>
                        <owl:hasValue>salé</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Nouilles"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Accompagnements -->

    <owl:Class rdf:about="http://www.semanticweb.org/zhengruixing/ontologies/2025/2/untitled-ontology-7/Accompagnements">
